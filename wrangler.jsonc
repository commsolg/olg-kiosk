// Cloudflare Workers settings (safe to keep in GitHub: no secrets here).
// Secrets go in the Cloudflare dashboard: Worker > Settings > Variables and Secrets:
//   APP_SECRET, MP_CLIENT_SECRET, SQUARE_ACCESS_TOKEN, SQUARE_WEBHOOK_SIGNATURE_KEY
{
  "name": "olg-pledge-widget",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Keep variables typed into the dashboard when GitHub deploys (secrets are always kept)
  "keep_vars": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://olghelotes.org,https://www.olghelotes.org",
    "PARISH_TIMEZONE": "America/Chicago",

    "MP_BASE_URL": "https://mp.olghelotes.org",
    "MP_CLIENT_ID": "OLG.PledgeWidget",
    "MP_ALLOWED_CAMPAIGN_IDS": "8",
    "MP_CAMPAIGN_PROGRAMS": "8:60",
    "MP_DEFAULT_DONOR_ID": "1",
    "MP_BATCH_ENTRY_TYPE_ID": "10",
    "MP_PAYMENT_TYPE_ID": "4",
    "MP_CONGREGATION_ID": "1",
    "MP_BATCH_NAME_PREFIX": "Square Online",
    "MP_ALWAYS_PENDING": "0",
    "MP_SET_PLEDGE_ON_DISTRIBUTION": "1",
    // Create donor records / new contacts automatically so gifts show under the person's name
    "MP_CREATE_DONORS": "1",
    "MP_CREATE_CONTACTS": "1",
    // Households = registered parishioners, so new people get a Contact + Donor only
    "MP_CREATE_HOUSEHOLDS": "0",
    // Second Phase card: $20 weekly or $80 monthly (or your own gift), always exactly 12 months
    "MP_TERM_MONTHS": "12",
    "MP_FREQUENCIES": "weekly,monthly,once",
    "MP_STATEMENT_FREQUENCY_ID": "1",
    "MP_STATEMENT_TYPE_ID": "2",
    "MP_STATEMENT_METHOD_ID": "1",
    "MP_STATEMENT_METHOD_NO_ADDRESS_ID": "2",
    "MP_HOUSEHOLD_SOURCE_ID": "19",
    "MP_HOUSEHOLD_POSITION_ID": "1",

    // Switch to "production" (and production token/location/webhook key) to go live
    "SQUARE_ENVIRONMENT": "sandbox",
    "SQUARE_LOCATION_ID": "LFNSM7BTRRNJS",
    "SQUARE_API_VERSION": "2025-01-23",
    "SQUARE_POST_ALL_PAYMENTS": "0",
    "SQUARE_ITEM_NAME": "Building Faith Together – Second Phase"
  }
}
